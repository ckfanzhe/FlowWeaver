# FlowWeaver — example environment configuration
#
# Copy this file to `.env` and fill in the values you need.
# For local development with vLLM or a local mock server, only the
# `OPENAI_*` block is required. The Anthropic block is shown for
# users running against the real Anthropic API.
#
# Variables prefixed `AGNOBUILDER_` configure the FastAPI backend.
# Variables prefixed `VITE_` configure the React frontend at build time.

# ============================================================
# Backend (FastAPI)
# ============================================================

# Postgres connection string. The platform is Postgres-only (SQLite
# support was dropped in the v1.5 migration; see plan
# [[gleaming-munching-grove]]). The default below points at the
# `postgres` service in `docker-compose.yml`. Override with a
# different host (e.g. `localhost`) when running outside compose.
AGNOBUILDER_DATABASE_URL=postgresql+psycopg://agnobuilder:agnobuilder@postgres:5432/agnobuilder

# Comma-separated CORS origins. The special value `*` enables
# wildcard mode (internal-network / LAN only; per
# [[agnobuilder-internal-only]]). Backend auto-disables
# `allow_credentials` when wildcard is active. Default covers
# the Vite dev ports only.
AGNOBUILDER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For LAN / internal-network deployment:
# AGNOBUILDER_CORS_ORIGINS=*

# Per-session cleanup TTL (seconds) and background tick (seconds).
# The default cron drops sessions idle > 30 min, ticked every 60 s.
# Set `AGNOBUILDER_SKIP_CLEANUP=1` to disable the cleanup task entirely
# (useful for tests + single-process development).
# AGNOBUILDER_SKIP_CLEANUP=1
# AGNOBUILDER_SESSION_TTL_SECONDS=1800
# AGNOBUILDER_CLEANUP_INTERVAL_SECONDS=60

# Seed the workflow-template gallery on startup.
# `AGNOBUILDER_SKIP_SEED=1` disables the seed (tests do this).
# AGNOBUILDER_SKIP_SEED=1

# Skip the FastAPI lifespan's cleanup task. Same effect as the TTL
# variables above, but a hard off switch.
# AGNOBUILDER_SKIP_CLEANUP=1

# ============================================================
# LLM provider credentials
# ============================================================
# Production code MUST NOT read these from environment variables;
# credentials live in the per-user `LlmPreset` table and are bound
# to a specific user. The variables below exist ONLY so the test
# suite (`backend/tests/conftest.py::real_llm_preset`) can drive an
# integration run against a real provider. They have no effect on
# the runtime API itself.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI-compatible (e.g. local vLLM) ---
# vLLM does not validate api_key by default; "EMPTY" is the standard
# placeholder for a local server.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
BASE_MODEL=Qwen3-8B

# --- Google (Gemini) ---
# GOOGLE_API_KEY=...
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# --- xAI (Grok) ---
# XAI_API_KEY=...
# XAI_BASE_URL=https://api.x.ai

# ============================================================
# Frontend (Vite, build-time only)
# ============================================================

# API base URL the frontend talks to. Default: http://localhost:8880.
# VITE_API_BASE=http://localhost:8880

# UI language preference (zh-CN, en). Falls back to browser default.
# VITE_DEFAULT_LOCALE=zh-CN

# ============================================================
# Docker Compose (read by `docker compose up` ONLY)
# ============================================================
# These vars power `docker-compose.yml::postgres` + the backend's
# `AGNOBUILDER_DATABASE_URL` override. They are ignored by the local
# `start.sh` path. For the compose path, fill these in (or accept
# the defaults — `agnobuilder/agnobuilder/agnobuilder` works out of
# the box for local dev).

# Postgres container bootstrap vars (consumed by the `postgres` image).
POSTGRES_USER=agnobuilder
POSTGRES_PASSWORD=agnobuilder
POSTGRES_DB=agnobuilder

# Backend → Postgres URL when running under docker-compose.
# `docker-compose.yml` overrides `AGNOBUILDER_DATABASE_URL` via
# `environment:` so the value baked into the backend container points
# at the compose-network `postgres` service. The default above points
# at `postgres` too — works the same with or without compose.
# Compose sets it to `postgresql+psycopg://...@postgres:5432/...`.