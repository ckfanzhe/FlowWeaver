    "knowledge": {
      "_doc_": "RAG / knowledge source node. Mirrors `tool`/`tool_source` architecturally — a source node that does NOT appear in `wf.steps`; instead it lands in `ctx.knowledge_objects[nid]` and gets wired to an agent's `knowledge=...` parameter via a `kind: 'knowledge_attachment'` edge. v1 ships a single hard-coded stack: `vectorDb='pgvector'` (sharing the docker-compose `pgvector/pgvector:pg16` instance) + `embedder='openai'` (compatible with OpenAI / Azure / self-hosted OpenAI-compatible endpoints like vLLM). `sources[]` records what the user wants indexed; the export emits only the `Knowledge(...)` constructor (users call `kb_<nid>.insert(path=...)` themselves). See plan [[gleaming-munching-grove]].",
      "kind": "knowledge_source",
      "category": "Data",
      "displayName": "Knowledge",
      "i18nKey": "knowledge",
      "color": "border-teal-400/50 bg-teal-50 dark:bg-teal-950",
      "textColor": "text-teal-700 dark:text-teal-300",
      "icon": "KnowledgeIcon",
      "configSchemaRef": "KnowledgeNodeConfig",
      "defaultConfig": {
        "name": "",
        "description": "",
        "maxResults": 10,
        "addKnowledgeToContext": false,
        "vectorDb": "pgvector",
        "pgvectorDbUrl": "postgresql+psycopg://agnobuilder:agnobuilder@postgres:5432/agnobuilder",
        "pgvectorTableName": "agno_kb",
        "pgvectorSchema": "ai",
        "embedder": "openai",
        "openaiModel": "text-embedding-3-small",
        "openaiApiKey": null,
        "openaiBaseUrl": null,
        "openaiDimensions": null,
        "sources": []
      },
      "capabilities": {
        "compoundPass": null,
        "isToolSource": false,
        "isKnowledgeSource": true,
        "needsToolWiring": false,
        "needsKnowledgeWiring": false,
        "skipPass1": true,
