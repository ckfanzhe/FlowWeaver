    "tool": {
      "_doc_": "replaces the prior standalone `http` + `mcp` + `tools` entries. `source` discriminator (`mcp` | `http` | `function`) selects which tool-emit primitive to build at runtime. Default `function` so a freshly-dropped `tool` node is a no-op empty-function source until the user picks a different mode.`preset` discriminator (`wikipedia` | `tavily_search` | `duckduckgo` | `calculator` | `arxiv_search` | null) collapses the prior 5 preset node types into this single `tool` entry — preset is checked BEFORE `source`, falling through to the source-based dispatch for HTTP presets (wikipedia) or toolkit-class lookup for.",
      "kind": "tool_source",
      "category": "Data",
      "displayName": "Tool",
      "i18nKey": "tool",
      "color": "border-amber-400/50 bg-amber-50 dark:bg-amber-950",
      "textColor": "text-amber-700 dark:text-amber-300",
      "icon": "ToolIcon",
      "configSchemaRef": "ToolNodeConfig",
      "defaultConfig": {
        "source": "function",
        "preset": null,
        "toolName": "",
        "toolDescription": "",
        "functions": [],
        "enabled_methods": [],
        "toolkit_options": {}
      },
      "capabilities": {
        "compoundPass": null,
        "isToolSource": true,
        "needsToolWiring": false,
        "skipPass1": false,
        "stepWrapper": "none"
      },
      "ui": {
